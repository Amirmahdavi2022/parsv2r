<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night theme: near-black window, gold accent. -->
    <style name="AppThemeBase" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:windowBackground">@color/window_background_dark</item>
        <item name="colorAccent">@color/parsv2r_gold</item>
        <item name="colorPrimary">@color/parsv2r_gold</item>
        <item name="colorPrimaryDark">@color/parsv2r_ink</item>
    </style>

    <style name="AppThemeDayNight" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar" parent="AppThemeBase" />

    <style name="AppThemeDayNight.NoActionBar.Translucent" parent="AppThemeBase">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
